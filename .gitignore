# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, linter, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Python packaging and build output
build/
dist/
*.egg-info/
*.egg
wheels/

# Local secrets and environment configuration
.env
.env.*
!.env.example
*.pem
*.key

# Generated Metal/Instruments captures
*.trace/
*.trace

# Generated test-session transcript
results/tests.txt

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Xcode user and build data
DerivedData/
*.xcuserstate
xcuserdata/

# Editors and local IDE settings
.idea/
.vscode/
*.swp
*.swo
*~

# Logs and temporary files
*.log
*.tmp
*.temp
.cache/
